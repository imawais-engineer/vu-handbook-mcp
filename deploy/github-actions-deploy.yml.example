# OPTIONAL - NOT ENABLED. To enable: copy to .github/workflows/deploy-azure.yml and add the secrets/vars.
# Deploys by running deploy/update.sh on the VM through Azure Run Command (no SSH port needed).
# Needs an Entra app registration with a federated credential (OIDC) for this repo and
# "Virtual Machine Contributor" on the resource group. Azure for Students tenants may block app
# registrations; then deploy manually with deploy/update.sh.
name: Deploy to Azure VM

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "git ref to deploy (sha, tag or origin/main)"
        default: "origin/main"

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - name: Run update on VM
        env:
          REF: ${{ inputs.ref }}
          RG: ${{ vars.AZURE_RG }}
          VM: ${{ vars.AZURE_VM }}
        run: |
          az vm run-command invoke -g "$RG" -n "$VM" --command-id RunShellScript \
            --scripts "/opt/vu-handbook-mcp/deploy/update.sh '$REF'" \
            --query 'value[0].message' -o tsv
