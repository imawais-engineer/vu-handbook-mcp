# systemd alternative (no Docker). Install:
#   sudo useradd --system --home /opt/vu-handbook-mcp --shell /usr/sbin/nologin vumcp
#   sudo git clone https://github.com/imawais-engineer/vu-handbook-mcp.git /opt/vu-handbook-mcp
#   sudo python3 -m venv /opt/vu-handbook-mcp/.venv
#   sudo /opt/vu-handbook-mcp/.venv/bin/pip install "mcp>=1.13,<2"
#   sudo install -m 600 -o vumcp deploy/.env.example /etc/vu-handbook-mcp.env   # then edit
#   sudo cp deploy/vu-handbook-mcp.service /etc/systemd/system/ && sudo systemctl enable --now vu-handbook-mcp
#   Caddy from apt (https://caddyserver.com/docs/install#debian-ubuntu-raspbian) with deploy/Caddyfile
#   and MCP_UPSTREAM=127.0.0.1:8000 in /etc/default/caddy (plus MCP_PUBLIC_HOST, ACME_EMAIL).
[Unit]
Description=VU Handbook MCP server (Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
User=vumcp
Group=vumcp
WorkingDirectory=/opt/vu-handbook-mcp
EnvironmentFile=/etc/vu-handbook-mcp.env
Environment=MCP_BIND=127.0.0.1 MCP_PORT=8000 MCP_TRUSTED_PROXIES=127.0.0.1
ExecStart=/opt/vu-handbook-mcp/.venv/bin/python deploy/serve.py
Restart=on-failure
RestartSec=3
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
