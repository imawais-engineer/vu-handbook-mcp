# Copy to deploy/.env (chmod 600). NEVER commit deploy/.env.
# Public hostname served by Caddy (own subdomain, or <label>.<region>.cloudapp.azure.com)
MCP_PUBLIC_HOST=vumcp.example.com
# Let's Encrypt contact email
ACME_EMAIL=you@example.com
# One or more comma-separated bearer tokens. Generate: openssl rand -base64 32 | tr -d '=+/'
MCP_BEARER_TOKENS=replace-with-a-long-random-token
# Set to 1 only if you want an open endpoint (handbook data is public; rate limit still applies)
MCP_ALLOW_ANONYMOUS=0
# Per-client-IP rate limit
MCP_RATE_PER_MIN=60
MCP_RATE_BURST=30
# Optional: browser origins allowed to call the endpoint (comma-separated)
MCP_ALLOWED_ORIGINS=
MCP_LOG_LEVEL=info
